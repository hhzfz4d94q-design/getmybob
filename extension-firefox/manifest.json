{
  "manifest_version": 2,
  "name": "getmemyjob Helper (Firefox)",
  "version": "0.1.2",
  "description": "Auto-fills job applications on Greenhouse, Lever, Ashby, and Workday using your getmemyjob profile.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "getmemyjob Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://*.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://cool-darkness-dce5.tr6jz6v7wg.workers.dev/*",
    "https://getmemyjob.officebeatllc.com/*",
    "https://getmyjob.officebeatllc.com/*",
    "https://getmemyjob.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*"
      ],
      "js": [
        "content_scripts/common.js",
        "content_scripts/greenhouse.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.lever.co/*"
      ],
      "js": [
        "content_scripts/common.js",
        "content_scripts/lever.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "content_scripts/common.js",
        "content_scripts/ashby.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*"
      ],
      "js": [
        "content_scripts/common.js",
        "content_scripts/workday.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://getmemyjob.officebeatllc.com/*",
        "https://getmyjob.officebeatllc.com/*",
        "https://getmemyjob.pages.dev/*"
      ],
      "js": [
        "content_scripts/getmemyjob_marker.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "getmemyjob-helper@officebeatllc.com",
      "strict_min_version": "115.0"
    }
  }
}